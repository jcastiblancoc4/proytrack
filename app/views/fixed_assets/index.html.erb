<div class="max-w-6xl mx-auto mt-6 px-4">
  <!-- Header -->
  <div class="flex items-center justify-between mb-6">
    <div>
      <h1 class="text-2xl font-bold text-gray-800">Activos Fijos</h1>
      <p class="text-sm text-gray-500 mt-1"><%= @fixed_assets.count %> activo(s) registrado(s)</p>
    </div>
    <%= link_to new_fixed_asset_path,
          class: "inline-flex items-center gap-2 bg-green-700 hover:bg-green-800 text-white text-sm font-medium px-4 py-2 rounded-lg transition-colors" do %>
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
      </svg>
      Registrar Activo
    <% end %>
  </div>

  <% if @fixed_assets.empty? %>
    <div class="bg-white border border-gray-200 rounded-xl p-12 text-center shadow-sm">
      <svg class="w-12 h-12 text-gray-300 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10"/>
      </svg>
      <p class="text-gray-500 font-medium">No hay activos fijos registrados</p>
      <p class="text-gray-400 text-sm mt-1">Registra el primer activo fijo</p>
    </div>
  <% else %>
    <div class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden">

      <!-- Tabla (escritorio) -->
      <div class="hidden sm:block overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
          <thead>
            <tr class="bg-gray-50">
              <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Nombre</th>
              <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Serial</th>
              <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider hidden lg:table-cell">Fecha Compra</th>
              <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider hidden md:table-cell">Precio Compra</th>
              <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider hidden lg:table-cell">Responsable</th>
              <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Estado</th>
              <th class="px-4 py-3 text-center text-xs font-semibold text-gray-500 uppercase tracking-wider">Acciones</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <% @fixed_assets.each do |asset| %>
              <tr class="hover:bg-gray-50 transition-colors">
                <td class="px-4 py-3">
                  <div class="flex items-center gap-2">
                    <% if asset.attachment_present? %>
                      <% if asset.attachment_image? %>
                        <img src="<%= asset.attachment_url %>" class="w-8 h-8 rounded object-cover border border-gray-200 flex-shrink-0" alt="">
                      <% else %>
                        <div class="w-8 h-8 rounded bg-red-50 border border-red-200 flex items-center justify-center flex-shrink-0">
                          <svg class="w-4 h-4 text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"/>
                          </svg>
                        </div>
                      <% end %>
                    <% end %>
                    <span class="text-sm font-medium text-gray-800"><%= asset.name %></span>
                  </div>
                </td>
                <td class="px-4 py-3 text-sm text-gray-600 font-mono"><%= asset.serial %></td>
                <td class="px-4 py-3 text-sm text-gray-600 hidden lg:table-cell">
                  <%= asset.purchase_date&.strftime('%d/%m/%Y') %>
                </td>
                <td class="px-4 py-3 text-sm text-gray-600 hidden md:table-cell">
                  <%= number_to_currency(asset.purchase_price&.fractional.to_f / 100, unit: '$', separator: ',', delimiter: '.', precision: 0) rescue '-' %>
                </td>
                <td class="px-4 py-3 text-sm text-gray-600 hidden lg:table-cell"><%= asset.responsible %></td>
                <td class="px-4 py-3">
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium <%= asset.status_badge_class %>">
                    <%= asset.status_label %>
                  </span>
                </td>
                <td class="px-4 py-3">
                  <div class="flex items-center justify-center gap-3">
                    <%= link_to fixed_asset_path(asset), class: "text-xs text-green-700 hover:text-green-900 font-medium" do %>Ver<% end %>
                    <%= link_to edit_fixed_asset_path(asset), class: "text-xs text-indigo-600 hover:text-indigo-800 font-medium" do %>Editar<% end %>
                    <%= button_to fixed_asset_path(asset),
                          method: :delete,
                          form: { data: { turbo_confirm: "¿Eliminar el activo #{asset.name}?" } },
                          class: "text-xs text-red-500 hover:text-red-700 font-medium bg-transparent border-none p-0 cursor-pointer" do %>Eliminar<% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <!-- Tarjetas (móvil) -->
      <div class="sm:hidden divide-y divide-gray-100">
        <% @fixed_assets.each do |asset| %>
          <div class="px-4 py-4 hover:bg-gray-50 transition-colors">
            <div class="flex items-start gap-3">

              <!-- Miniatura o ícono -->
              <div class="flex-shrink-0">
                <% if asset.attachment_present? && asset.attachment_image? %>
                  <img src="<%= asset.attachment_url %>" class="w-11 h-11 rounded-lg object-cover border border-gray-200" alt="">
                <% else %>
                  <div class="w-11 h-11 rounded-lg bg-green-50 border border-green-200 flex items-center justify-center">
                    <svg class="w-5 h-5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10"/>
                    </svg>
                  </div>
                <% end %>
              </div>

              <div class="flex-1 min-w-0">
                <!-- Nombre + estado -->
                <div class="flex items-center gap-2 flex-wrap">
                  <p class="text-sm font-semibold text-gray-800 leading-snug"><%= asset.name %></p>
                  <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium <%= asset.status_badge_class %>">
                    <%= asset.status_label %>
                  </span>
                </div>

                <!-- Serial -->
                <p class="text-xs text-gray-500 mt-1 font-mono"><%= asset.serial %></p>

                <!-- Fecha y precio -->
                <div class="flex items-center gap-3 mt-1 flex-wrap">
                  <% if asset.purchase_date.present? %>
                    <p class="text-xs text-gray-500">
                      <span class="font-medium">Compra:</span> <%= asset.purchase_date.strftime('%d/%m/%Y') %>
                    </p>
                  <% end %>
                  <p class="text-xs text-gray-500">
                    <span class="font-medium">Precio:</span>
                    <%= number_to_currency(asset.purchase_price&.fractional.to_f / 100, unit: '$', separator: ',', delimiter: '.', precision: 0) rescue '-' %>
                  </p>
                </div>

                <!-- Responsable -->
                <p class="text-xs text-gray-500 mt-0.5">
                  <span class="font-medium">Responsable:</span> <%= asset.responsible %>
                </p>

                <!-- Acciones -->
                <div class="flex items-center gap-2 mt-2.5">
                  <%= link_to fixed_asset_path(asset),
                        class: "inline-flex items-center gap-1 text-xs text-green-700 bg-green-50 hover:bg-green-100 px-2.5 py-1 rounded-full transition-colors font-medium" do %>
                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                    </svg>
                    Ver
                  <% end %>
                  <%= link_to edit_fixed_asset_path(asset),
                        class: "inline-flex items-center gap-1 text-xs text-indigo-600 bg-indigo-50 hover:bg-indigo-100 px-2.5 py-1 rounded-full transition-colors font-medium" do %>
                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/>
                    </svg>
                    Editar
                  <% end %>
                  <%= button_to fixed_asset_path(asset),
                        method: :delete,
                        form: { data: { turbo_confirm: "¿Eliminar el activo #{asset.name}?" } },
                        class: "inline-flex items-center gap-1 text-xs text-red-600 bg-red-50 hover:bg-red-100 px-2.5 py-1 rounded-full transition-colors font-medium border-0 cursor-pointer" do %>
                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                    </svg>
                    Eliminar
                  <% end %>
                </div>
              </div>
            </div>
          </div>
        <% end %>
      </div>

    </div>
  <% end %>
</div>
