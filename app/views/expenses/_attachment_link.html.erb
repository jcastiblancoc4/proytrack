<% if expense.attachment_present? %>
  <% url = attachment_expense_path(expense, v: expense.attachment_drive_id) %>
  <a href="<%= url %>" target="_blank" data-turbo="false"
     x-data
     @click.prevent="$dispatch('open-attachment', <%= { url: url, download: attachment_expense_path(expense, filename: expense.attachment_download_name, download: 1), image: expense.attachment_image?, name: expense.attachment_filename }.to_json %>)"
     class="inline-flex items-center justify-center flex-shrink-0 w-6 h-6 rounded-md transition-colors cursor-pointer <%= expense.attachment_image? ? 'bg-green-50 text-green-600 hover:bg-green-100 hover:text-green-800' : 'bg-red-50 text-red-500 hover:bg-red-100 hover:text-red-700' %>"
     title="Ver soporte: <%= expense.attachment_filename %>">
    <% if expense.attachment_image? %>
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
      </svg>
    <% else %>
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
      </svg>
    <% end %>
  </a>
<% end %>
