<%# Campo para adjuntar el soporte (imagen o PDF) del gasto. Se guarda en Google Drive. %>
<% expense ||= nil %>
<% input_id = "expense-attachment-#{expense&.persisted? ? expense.id : 'new'}-#{SecureRandom.hex(3)}" %>
<div x-data="{
  fileName: '', fileSize: '', previewUrl: '', isImage: false, tooBig: false, processing: false, note: '',
  async pick(file) {
    if (this.previewUrl) URL.revokeObjectURL(this.previewUrl);
    this.previewUrl = ''; this.note = '';
    if (file && this.shouldCompress(file)) {
      this.processing = true;
      this.fileName = file.name;
      this.isImage = true;
      try {
        const compressed = await this.compress(file);
        if (compressed && compressed.size < file.size) {
          const dt = new DataTransfer();
          dt.items.add(compressed);
          this.$refs.fileInput.files = dt.files;
          this.note = 'Optimizada: ' + this.mb(file.size) + ' → ' + this.mb(compressed.size);
          file = compressed;
        }
      } catch (e) { /* si el navegador no puede procesarla, se envía la original */ }
      this.processing = false;
    }
    this.fileName = file ? file.name : '';
    this.isImage  = !!file && file.type.startsWith('image/');
    this.tooBig   = !!file && file.size > <%= Expense::MAX_ATTACHMENT_SIZE %>;
    this.fileSize = file ? this.mb(file.size) : '';
    if (this.isImage) this.previewUrl = URL.createObjectURL(file);
  },
  // Fotos de celular: se reducen a 1600 px y JPEG 82% (los GIF y las imágenes livianas no se tocan)
  shouldCompress(file) {
    return ['image/jpeg', 'image/jpg', 'image/png', 'image/webp'].includes(file.type) && file.size > 500 * 1024;
  },
  async compress(file) {
    const max = 1600;
    const bitmap = await createImageBitmap(file);
    const scale = Math.min(1, max / Math.max(bitmap.width, bitmap.height));
    const canvas = document.createElement('canvas');
    canvas.width = Math.round(bitmap.width * scale);
    canvas.height = Math.round(bitmap.height * scale);
    const ctx = canvas.getContext('2d');
    ctx.fillStyle = '#ffffff';
    ctx.fillRect(0, 0, canvas.width, canvas.height);
    ctx.drawImage(bitmap, 0, 0, canvas.width, canvas.height);
    bitmap.close && bitmap.close();
    const blob = await new Promise(resolve => canvas.toBlob(resolve, 'image/jpeg', 0.82));
    if (!blob) return null;
    return new File([blob], file.name.replace(/\.[^.]+$/, '') + '.jpg', { type: 'image/jpeg', lastModified: Date.now() });
  },
  mb(bytes) { return (bytes / 1024 / 1024).toFixed(2) + ' MB'; },
  watchForm(form) {
    if (!form) return;
    // No enviar mientras se comprime la imagen
    form.addEventListener('submit', e => {
      if (this.processing) { e.preventDefault(); e.stopImmediatePropagation(); }
    }, true);
    // turbo:submit-start solo ocurre si el envío arrancó (pasó las validaciones del formulario)
    form.addEventListener('turbo:submit-start', () => {
      if (!this.$refs.fileInput.files.length) return;
      const btn = form.querySelector('[type=submit]');
      if (!btn) return;
      btn.dataset.originalLabel = btn.value || btn.textContent;
      btn.tagName === 'INPUT' ? (btn.value = '⏳ Subiendo soporte...') : (btn.textContent = '⏳ Subiendo soporte...');
      btn.disabled = true;
    });
    form.addEventListener('turbo:submit-end', e => {
      if (e.detail.success) return;
      const btn = form.querySelector('[type=submit]');
      if (!btn || !btn.dataset.originalLabel) return;
      btn.tagName === 'INPUT' ? (btn.value = btn.dataset.originalLabel) : (btn.textContent = btn.dataset.originalLabel);
      btn.disabled = false;
    });
  },
  clear() { this.$refs.fileInput.value = ''; this.pick(null); }
}"
     x-init="watchForm($el.closest('form'))">

  <label class="block text-sm font-medium text-gray-700 mb-1">Soporte: imagen o PDF (opcional)</label>

  <% if expense&.persisted? && expense.attachment_present? %>
    <%# El ID de Drive versiona la URL para que el navegador no muestre en caché un soporte reemplazado %>
    <% attachment_url = attachment_expense_path(expense, v: expense.attachment_drive_id) %>
    <% open_modal = "$dispatch('open-attachment', #{ { url: attachment_url, download: attachment_expense_path(expense, filename: expense.attachment_download_name, download: 1), image: expense.attachment_image?, name: expense.attachment_filename }.to_json })" %>
    <div class="flex items-center gap-3 mb-3 p-3 bg-gray-50 border border-gray-200 rounded-lg">
      <% if expense.attachment_image? %>
        <a href="<%= attachment_url %>" target="_blank" data-turbo="false" @click.prevent="<%= open_modal %>" class="flex-shrink-0">
          <img src="<%= attachment_url %>" loading="lazy" class="w-16 h-16 object-cover rounded border border-gray-200" alt="Soporte del gasto">
        </a>
      <% else %>
        <a href="<%= attachment_url %>" target="_blank" data-turbo="false" @click.prevent="<%= open_modal %>"
           class="w-16 h-16 bg-red-50 border border-red-200 rounded flex items-center justify-center flex-shrink-0">
          <svg class="w-8 h-8 text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"/>
          </svg>
        </a>
      <% end %>
      <div class="flex-1 min-w-0">
        <a href="<%= attachment_url %>" target="_blank" data-turbo="false" @click.prevent="<%= open_modal %>"
           class="text-xs text-green-700 hover:underline truncate block"><%= expense.attachment_filename %></a>
        <label class="inline-flex items-center gap-1.5 mt-1.5 text-xs text-red-600 cursor-pointer">
          <input type="checkbox" name="expense[remove_attachment]" value="1" class="rounded">
          Eliminar soporte
        </label>
      </div>
    </div>
  <% end %>

  <!-- Vista previa del archivo seleccionado (aún no guardado) -->
  <div x-show="fileName" style="display:none;"
       class="mb-3 p-3 rounded-lg border"
       :class="tooBig ? 'bg-red-50 border-red-200' : 'bg-green-50 border-green-200'">
    <div class="flex items-center gap-3">
      <template x-if="isImage">
        <img :src="previewUrl" alt="Vista previa"
             class="w-20 h-20 flex-shrink-0 object-cover rounded-lg bg-white ring-1 ring-gray-300 shadow-sm">
      </template>
      <template x-if="!isImage">
        <div class="w-20 h-20 flex-shrink-0 bg-white border border-red-200 rounded-lg flex flex-col items-center justify-center text-red-500">
          <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"/>
          </svg>
          <span class="text-[10px] font-bold mt-0.5">PDF</span>
        </div>
      </template>
      <div class="flex-1 min-w-0">
        <p class="text-[11px] font-semibold uppercase tracking-wide"
           :class="tooBig ? 'text-red-600' : 'text-green-700'"
           x-text="tooBig ? 'El archivo supera los 10 MB' : '<%= expense&.attachment_present? ? "Nuevo soporte (reemplazará el actual)" : "Soporte seleccionado" %>'"></p>
        <p class="text-sm font-medium text-gray-800 truncate" x-text="fileName"></p>
        <p class="text-xs text-gray-500" x-show="!processing" x-text="fileSize"></p>
        <p class="text-xs text-gray-500" x-show="processing">Optimizando imagen...</p>
        <p class="text-xs text-green-700" x-show="note && !processing" x-text="note"></p>
        <button type="button" @click="clear()"
                class="mt-1 text-xs text-gray-500 hover:text-red-600 hover:underline cursor-pointer">Quitar selección</button>
      </div>
    </div>
  </div>

  <div x-show="!fileName" class="border-2 border-dashed border-gray-300 rounded-lg px-4 py-4 text-center hover:border-green-400 transition-colors">
    <label for="<%= input_id %>" class="cursor-pointer block">
      <svg class="w-7 h-7 text-gray-400 mx-auto mb-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
      </svg>
      <p class="text-sm text-gray-500">
        <span class="font-medium text-green-700 hover:text-green-800">
          <%= expense&.attachment_present? ? "Reemplazar archivo" : "Seleccionar archivo" %>
        </span>
      </p>
      <p class="text-xs text-gray-400 mt-1">JPG, PNG, GIF, WebP o PDF · máx. 10 MB</p>
    </label>
  </div>

  <%# El input queda fuera de los bloques con x-show para no perder el archivo al alternar la vista %>
  <input type="file" name="expense[attachment_file]" accept="image/*,application/pdf"
         class="sr-only" id="<%= input_id %>" x-ref="fileInput"
         @change="pick($event.target.files[0])">
</div>
