<div class="max-w-3xl mx-auto mt-6 px-4 pb-10">

  <!-- Header -->
  <div class="flex items-center gap-3 mb-6">
    <%= link_to fixed_asset_path(@fixed_asset), class: "text-gray-400 hover:text-gray-600 transition-colors" do %>
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
      </svg>
    <% end %>
    <div>
      <h1 class="text-2xl font-bold text-gray-800">Registrar Novedad</h1>
      <p class="text-sm text-gray-500 truncate"><%= @fixed_asset.name %></p>
    </div>
  </div>

  <% if @novelty.errors.any? %>
    <div class="bg-red-50 border border-red-200 rounded-lg p-4 mb-6">
      <div class="flex">
        <svg class="h-5 w-5 text-red-400 flex-shrink-0" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
        </svg>
        <div class="ml-3">
          <h3 class="text-sm font-medium text-red-800">Se encontraron <%= pluralize(@novelty.errors.count, "error") %>:</h3>
          <ul class="mt-2 text-sm text-red-700 list-disc pl-5 space-y-1">
            <% @novelty.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      </div>
    </div>
  <% end %>

  <%= form_with url: fixed_asset_asset_novelties_path(@fixed_asset), method: :post,
        local: true, multipart: true, class: "space-y-5" do |f| %>

    <!-- Datos de la novedad -->
    <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-5">
      <h2 class="text-sm font-semibold text-gray-700 uppercase tracking-wider mb-4">Datos de la novedad</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Nombre <span class="text-red-500">*</span></label>
          <input type="text" name="asset_novelty[name]" value="<%= @novelty.name %>"
                 placeholder="Ej: Daño en pantalla"
                 class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-green-200 focus:border-green-400 outline-none">
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Fecha <span class="text-red-500">*</span></label>
          <input type="date" name="asset_novelty[date]" value="<%= @novelty.date&.strftime('%Y-%m-%d') || Date.current.strftime('%Y-%m-%d') %>"
                 class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-green-200 focus:border-green-400 outline-none">
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Responsable <span class="text-red-500">*</span></label>
          <input type="text" name="asset_novelty[responsible]" value="<%= @novelty.responsible %>"
                 placeholder="Nombre del responsable"
                 class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-green-200 focus:border-green-400 outline-none">
        </div>
        <div class="md:col-span-2">
          <label class="block text-sm font-medium text-gray-700 mb-1">Descripción <span class="text-red-500">*</span></label>
          <textarea name="asset_novelty[description]" rows="3"
                    placeholder="Describe la novedad ocurrida..."
                    class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-green-200 focus:border-green-400 outline-none resize-none"><%= @novelty.description %></textarea>
        </div>
      </div>
    </div>

    <!-- Imagen de evidencia -->
    <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-5">
      <h2 class="text-sm font-semibold text-gray-700 uppercase tracking-wider mb-3">Imagen de evidencia <span class="text-xs font-normal text-gray-400 normal-case">(opcional)</span></h2>
      <div class="border-2 border-dashed border-gray-300 rounded-lg px-4 py-5 text-center hover:border-green-400 transition-colors">
        <input type="file" name="asset_novelty[evidence_file]" accept="image/*"
               class="sr-only" id="evidence-input">
        <label for="evidence-input" class="cursor-pointer">
          <svg class="w-8 h-8 text-gray-400 mx-auto mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
          </svg>
          <p class="text-sm text-gray-500">
            <span class="font-medium text-green-700 hover:text-green-800">Seleccionar imagen</span>
            o arrastra aquí
          </p>
          <p class="text-xs text-gray-400 mt-1">JPG, PNG, GIF o WebP</p>
        </label>
        <p id="evidence-preview" class="text-xs text-green-700 font-medium mt-2 hidden"></p>
      </div>
    </div>

    <!-- Firma del responsable -->
    <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-5">
      <h2 class="text-sm font-semibold text-gray-700 uppercase tracking-wider mb-1">Firma del responsable <span class="text-xs font-normal text-gray-400 normal-case">(opcional)</span></h2>
      <p class="text-xs text-gray-500 mb-3">Dibuja la firma en el recuadro de abajo.</p>
      <div class="border border-gray-300 rounded-lg overflow-hidden bg-white" style="touch-action: none;">
        <canvas id="signature-canvas" class="w-full block" style="height: 160px; cursor: crosshair;"></canvas>
      </div>
      <div class="flex justify-end mt-2">
        <button type="button" id="clear-signature"
                class="text-xs text-gray-400 hover:text-red-500 underline transition-colors">
          Limpiar firma
        </button>
      </div>
      <input type="hidden" name="signature_data" id="signature-data">
    </div>

    <!-- Acciones -->
    <div class="flex items-center justify-between pt-2">
      <%= link_to fixed_asset_path(@fixed_asset), class: "text-sm text-gray-500 hover:text-gray-700 font-medium" do %>Cancelar<% end %>
      <button type="submit"
              class="inline-flex items-center gap-2 bg-green-700 hover:bg-green-800 text-white font-medium px-6 py-2.5 rounded-lg transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
        </svg>
        Guardar novedad
      </button>
    </div>
  <% end %>

</div>

<script>
  // Firma
  (function () {
    const canvas = document.getElementById('signature-canvas');
    const input  = document.getElementById('signature-data');
    const ctx    = canvas.getContext('2d');
    let drawing  = false;
    let hasDrawn = false;

    function resize() {
      const ratio   = window.devicePixelRatio || 1;
      const rect    = canvas.getBoundingClientRect();
      canvas.width  = rect.width  * ratio;
      canvas.height = rect.height * ratio;
      ctx.scale(ratio, ratio);
      ctx.strokeStyle = '#1a1a1a';
      ctx.lineWidth   = 2;
      ctx.lineCap     = 'round';
      ctx.lineJoin    = 'round';
    }

    function getPos(e) {
      const rect = canvas.getBoundingClientRect();
      const src  = e.touches ? e.touches[0] : e;
      return { x: src.clientX - rect.left, y: src.clientY - rect.top };
    }

    function onStart(e) { e.preventDefault(); drawing = true; const p = getPos(e); ctx.beginPath(); ctx.moveTo(p.x, p.y); }
    function onMove(e)  { e.preventDefault(); if (!drawing) return; hasDrawn = true; const p = getPos(e); ctx.lineTo(p.x, p.y); ctx.stroke(); }
    function onStop(e)  { e.preventDefault(); drawing = false; if (hasDrawn) input.value = canvas.toDataURL('image/png'); }

    canvas.addEventListener('mousedown',  onStart);
    canvas.addEventListener('mousemove',  onMove);
    canvas.addEventListener('mouseup',    onStop);
    canvas.addEventListener('mouseleave', onStop);
    canvas.addEventListener('touchstart', onStart, { passive: false });
    canvas.addEventListener('touchmove',  onMove,  { passive: false });
    canvas.addEventListener('touchend',   onStop);

    document.getElementById('clear-signature').addEventListener('click', function () {
      const rect = canvas.getBoundingClientRect();
      ctx.clearRect(0, 0, rect.width, rect.height);
      input.value = '';
      hasDrawn = false;
    });

    resize();
    window.addEventListener('resize', function () { resize(); });
  })();

  // Preview nombre de evidencia
  document.getElementById('evidence-input').addEventListener('change', function () {
    const preview = document.getElementById('evidence-preview');
    if (this.files.length > 0) {
      preview.textContent = this.files[0].name;
      preview.classList.remove('hidden');
    } else {
      preview.classList.add('hidden');
    }
  });
</script>
