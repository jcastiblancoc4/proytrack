<div class="max-w-3xl mx-auto mt-6 px-4 pb-10">

  <!-- Header -->
  <div class="flex items-center gap-3 mb-6">
    <%= link_to fixed_asset_path(@fixed_asset), class: "text-gray-400 hover:text-gray-600 transition-colors" do %>
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
      </svg>
    <% end %>
    <div class="min-w-0">
      <p class="text-xs text-gray-500 truncate"><%= @fixed_asset.name %></p>
      <h1 class="text-2xl font-bold text-gray-800 truncate"><%= @novelty.name %></h1>
    </div>
  </div>

  <div class="space-y-5">

    <!-- Datos principales -->
    <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-5">
      <dl class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <dt class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Fecha</dt>
          <dd class="mt-1 text-sm text-gray-800"><%= @novelty.date&.strftime('%d/%m/%Y') %></dd>
        </div>
        <div>
          <dt class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Responsable</dt>
          <dd class="mt-1 text-sm text-gray-800"><%= @novelty.responsible %></dd>
        </div>
        <div class="sm:col-span-2">
          <dt class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Descripción</dt>
          <dd class="mt-1 text-sm text-gray-800 whitespace-pre-line"><%= @novelty.description %></dd>
        </div>
      </dl>
    </div>

    <!-- Evidencia + Firma lado a lado cuando ambas existen -->
    <% if @novelty.evidence_present? || @novelty.signature_url.present? %>
      <div class="grid grid-cols-1 <%= @novelty.evidence_present? && @novelty.signature_url.present? ? 'md:grid-cols-2' : '' %> gap-5">

        <% if @novelty.evidence_present? %>
          <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-5">
            <h2 class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-3">Imagen de evidencia</h2>
            <img src="<%= @novelty.evidence_url %>"
                 class="w-full max-h-72 object-contain rounded-lg border border-gray-100"
                 alt="Evidencia">
          </div>
        <% end %>

        <% if @novelty.signature_url.present? %>
          <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-5">
            <h2 class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-3">Firma del responsable</h2>
            <div class="border border-gray-200 rounded-lg overflow-hidden bg-gray-50 flex items-center justify-center p-2" style="min-height: 120px;">
              <img src="<%= @novelty.signature_url %>"
                   class="max-h-36 w-auto"
                   alt="Firma">
            </div>
          </div>
        <% end %>

      </div>
    <% end %>

    <!-- Acciones -->
    <div class="flex items-center justify-between pt-2">
      <%= link_to fixed_asset_path(@fixed_asset),
            class: "inline-flex items-center gap-1.5 text-sm text-gray-500 hover:text-gray-700 font-medium transition-colors" do %>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
        Volver al activo
      <% end %>
      <%= button_to fixed_asset_asset_novelty_path(@fixed_asset, @novelty),
            method: :delete,
            form: { data: { turbo_confirm: "¿Eliminar esta novedad?" } },
            class: "inline-flex items-center gap-1.5 text-sm text-red-600 bg-red-50 hover:bg-red-100 font-medium px-4 py-2 rounded-lg transition-colors border border-red-200" do %>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
        </svg>
        Eliminar novedad
      <% end %>
    </div>

  </div>
</div>
