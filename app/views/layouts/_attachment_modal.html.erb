<%# Modal para ver soportes de gastos (imagen o PDF). Se abre con: $dispatch('open-attachment', { url, download, image, name }) %>
<div x-data="{ open: false, url: '', download: '', image: false, name: '', loading: true,
               show(d) { this.url = d.url; this.download = d.download || d.url; this.image = d.image; this.name = d.name || 'Soporte'; this.loading = true; this.open = true },
               close() { this.open = false; this.url = '' },
               downloadUrl() { return this.download } }"
     @open-attachment.window="show($event.detail)"
     @keydown.escape.window="open && close()"
     x-show="open" x-cloak
     class="fixed inset-0 z-50 flex items-center justify-center p-3 sm:p-6"
     style="display:none; padding-top: max(0.75rem, env(safe-area-inset-top)); padding-bottom: max(0.75rem, env(safe-area-inset-bottom));">
  <div class="absolute inset-0 bg-gray-900/40 backdrop-blur-sm" @click="close()"
       x-show="open" x-transition.opacity></div>

  <div class="relative w-full max-w-5xl max-h-[94vh] flex flex-col overflow-hidden rounded-2xl bg-gray-100 ring-1 ring-gray-300 shadow-2xl"
       x-show="open"
       x-transition:enter="transition ease-out duration-200" x-transition:enter-start="opacity-0 scale-95" x-transition:enter-end="opacity-100 scale-100">

    <!-- Encabezado -->
    <div class="flex items-center justify-between gap-3 px-4 py-3 bg-white border-b border-gray-200">
      <div class="flex items-center gap-2 min-w-0">
        <span class="w-7 h-7 flex-shrink-0 rounded-lg flex items-center justify-center"
              :class="image ? 'bg-green-100 text-green-700' : 'bg-red-100 text-red-600'">
          <svg x-show="image" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
          </svg>
          <svg x-show="!image" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"/>
          </svg>
        </span>
        <div class="min-w-0">
          <p class="text-[11px] font-medium uppercase tracking-wider text-gray-500">Soporte del gasto</p>
          <p class="text-sm font-semibold text-gray-800 truncate" x-text="name"></p>
        </div>
      </div>
      <div class="flex items-center gap-2 flex-shrink-0">
        <a :href="downloadUrl()" target="_blank" data-turbo="false"
           class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold text-white bg-green-600 hover:bg-green-700 rounded-lg transition-colors">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
          </svg>
          <span class="hidden sm:inline">Descargar</span>
        </a>
        <button type="button" @click="close()" title="Cerrar (Esc)"
                class="w-8 h-8 flex items-center justify-center rounded-lg text-gray-400 hover:text-gray-700 hover:bg-gray-100 transition-colors cursor-pointer">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>
    </div>

    <!-- Contenido -->
    <div class="relative flex-1 min-h-[16rem] overflow-auto flex items-center justify-center p-4 sm:p-6 bg-gray-200">
      <div x-show="loading" class="absolute inset-0 flex flex-col items-center justify-center gap-3 text-sm text-gray-500">
        <svg class="w-8 h-8 animate-spin text-green-500" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"></path>
        </svg>
        Cargando soporte...
      </div>
      <template x-if="open && image">
        <img :src="url" :alt="name" @load="loading = false" @error="loading = false"
             :class="loading ? 'opacity-0' : 'opacity-100'"
             class="max-w-full max-h-[78vh] object-contain rounded-lg ring-1 ring-gray-300 shadow-[0_8px_30px_rgba(0,0,0,0.18)] transition-opacity duration-200">
      </template>
      <% if inline_pdf_supported? %>
        <template x-if="open && !image">
          <iframe :src="url" @load="loading = false" title="Soporte PDF"
                  class="w-full h-[78vh] rounded-lg bg-white ring-1 ring-gray-300 shadow-[0_8px_30px_rgba(0,0,0,0.18)]"></iframe>
        </template>
      <% else %>
        <%# Android no muestra PDF embebido: se ofrece abrirlo con el visor del dispositivo %>
        <template x-if="open && !image">
          <div x-init="loading = false" class="flex flex-col items-center text-center gap-3 py-10 px-4">
            <div class="w-16 h-16 rounded-2xl bg-white border border-red-200 flex items-center justify-center text-red-500 shadow-sm">
              <svg class="w-9 h-9" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"/>
              </svg>
            </div>
            <p class="text-sm text-gray-600 max-w-xs">La vista previa de PDF no está disponible en este dispositivo. Descárgalo para abrirlo con el visor del teléfono.</p>
            <a :href="downloadUrl()" target="_blank" data-turbo="false"
               class="inline-flex items-center gap-2 px-4 py-2.5 text-sm font-semibold text-white bg-green-600 hover:bg-green-700 rounded-xl transition-colors">
              Descargar PDF
            </a>
          </div>
        </template>
      <% end %>
    </div>
  </div>
</div>
