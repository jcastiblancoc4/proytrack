<!DOCTYPE html>
<html>
  <head>
    <title>Proytrack</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application" %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <script src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js" defer></script>

  </head>

  <body class="bg-gray-100">
  <div id="flash-messages" class="fixed top-4 left-1/2 transform -translate-x-1/2 z-50 w-full max-w-md px-4">
    <% flash.each do |type, message| %>
      <% flash_class =
           case type.to_sym
           when :notice then "bg-green-100 text-green-800 border-green-300"
           when :alert then "bg-red-100 text-red-800 border-red-300"
           when :error then "bg-yellow-100 text-yellow-800 border-yellow-300"
           else "bg-gray-100 text-gray-800 border-gray-300"
           end
      %>
      <div class="flash-alert border-l-4 p-4 mb-3 rounded shadow-sm transition-opacity duration-300 opacity-100 <%= flash_class %>">
        <p class="text-sm font-medium"><%= message %></p>
      </div>
    <% end %>
  </div>

  <% if user_signed_in? %>
    <%
      user_initials = current_user.email.split("@").first.upcase.first(2)

      inicio_item = {
        label: "Inicio", path: root_path, active: current_page?(root_path), admin_only: true,
        icon: "M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"
      }

      nav_groups = [
        {
          key: "proyectos",
          label: "Gestión de Proyectos",
          icon: "M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z",
          items: [
            { label: "Proyectos",    path: projects_path,         active: request.path.start_with?("/projects"),         admin_only: true,  icon: "M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z" },
            { label: "Inspecciones", path: inspection_forms_path, active: request.path.start_with?("/inspection_forms"), admin_only: false, icon: "M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2M9 12h6m-6 4h4" },
          ]
        },
        {
          key: "finanzas",
          label: "Finanzas",
          icon: "M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z",
          items: [
            { label: "Cuentas",       path: accounts_path,    active: request.path.start_with?("/accounts"),    admin_only: true, icon: "M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" },
            { label: "Gastos",        path: expenses_path,    active: request.path.start_with?("/expenses"),    admin_only: true, icon: "M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z" },
            { label: "Liquidaciones", path: settlements_path, active: request.path.start_with?("/settlements"), admin_only: true, icon: "M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" },
          ]
        },
        {
          key: "administracion",
          label: "Administración",
          icon: "M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065zM15 12a3 3 0 11-6 0 3 3 0 016 0z",
          items: [
            { label: "Terceros",      path: third_parties_path, active: request.path.start_with?("/third_parties"), admin_only: true, icon: "M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" },
            { label: "Activos Fijos", path: fixed_assets_path,  active: request.path.start_with?("/fixed_assets"),  admin_only: true, icon: "M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10" },
          ]
        },
      ]

      inicio_visible = admin_user? || !inicio_item[:admin_only]
      nav_groups.each { |g| g[:items] = admin_user? ? g[:items] : g[:items].reject { |i| i[:admin_only] } }
      nav_groups = nav_groups.reject { |g| g[:items].empty? }
      nav_groups.each { |g| g[:active] = g[:items].any? { |i| i[:active] } }

      open_groups_json = nav_groups.map { |g| "#{g[:key]}: #{g[:active]}" }.join(", ")
    %>

    <div x-data="{ sidebarOpen: false, userOpen: false, openGroups: { <%= open_groups_json %> } }" class="min-h-screen flex bg-gray-100">

      <!-- Overlay móvil -->
      <div x-show="sidebarOpen" x-cloak @click="sidebarOpen = false"
           x-transition:enter="transition-opacity ease-linear duration-200" x-transition:enter-start="opacity-0" x-transition:enter-end="opacity-100"
           x-transition:leave="transition-opacity ease-linear duration-150" x-transition:leave-start="opacity-100" x-transition:leave-end="opacity-0"
           class="fixed inset-0 bg-black/50 z-30 lg:hidden"></div>

      <!-- Sidebar -->
      <aside :class="sidebarOpen ? 'translate-x-0' : '-translate-x-full'"
             class="fixed inset-y-0 left-0 z-40 w-64 flex flex-col transform transition-transform duration-200 ease-in-out lg:translate-x-0 lg:static lg:flex-shrink-0"
             style="background: linear-gradient(180deg, #0f3d22 0%, #1a6b3a 100%)">

        <div class="h-16 flex items-center justify-between px-5 flex-shrink-0 border-b border-white/10">
          <%= link_to root_path, class: "flex items-center gap-2.5" do %>
            <div class="w-8 h-8 rounded-lg flex items-center justify-center bg-white/15">
              <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
              </svg>
            </div>
            <span class="text-lg font-bold tracking-tight text-white">ProyTrack</span>
          <% end %>
          <button @click="sidebarOpen = false" type="button" class="lg:hidden text-white/70 hover:text-white p-1" aria-label="Cerrar menú">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
          </button>
        </div>

        <nav class="flex-1 overflow-y-auto px-3 py-4 space-y-1">
          <% if inicio_visible %>
            <%= link_to inicio_item[:path],
                  class: "flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors #{inicio_item[:active] ? 'bg-white text-green-900 shadow-sm' : 'text-white/80 hover:text-white hover:bg-white/10'}" do %>
              <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="<%= inicio_item[:icon] %>"/>
              </svg>
              <%= inicio_item[:label] %>
            <% end %>
          <% end %>

          <% nav_groups.each do |group| %>
            <div>
              <button type="button" @click="openGroups.<%= group[:key] %> = !openGroups.<%= group[:key] %>"
                      class="w-full flex items-center justify-between gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors <%= group[:active] ? 'text-white' : 'text-white/80 hover:text-white hover:bg-white/10' %>">
                <span class="flex items-center gap-3">
                  <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="<%= group[:icon] %>"/>
                  </svg>
                  <%= group[:label] %>
                </span>
                <svg class="w-4 h-4 flex-shrink-0 transition-transform" :class="openGroups.<%= group[:key] %> ? 'rotate-180' : ''" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                </svg>
              </button>
              <div x-show="openGroups.<%= group[:key] %>" x-cloak class="mt-0.5 ml-3 pl-3 border-l border-white/10 space-y-0.5">
                <% group[:items].each do |item| %>
                  <%= link_to item[:path],
                        class: "flex items-center gap-3 px-3 py-2 rounded-lg text-sm font-medium transition-colors #{item[:active] ? 'bg-white text-green-900 shadow-sm' : 'text-white/70 hover:text-white hover:bg-white/10'}" do %>
                    <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="<%= item[:icon] %>"/>
                    </svg>
                    <%= item[:label] %>
                  <% end %>
                <% end %>
              </div>
            </div>
          <% end %>
        </nav>
      </aside>

      <!-- Columna principal -->
      <div class="flex-1 flex flex-col min-w-0">

        <!-- Topbar -->
        <header class="h-16 bg-white border-b border-gray-200 flex items-center justify-between px-4 sm:px-6 flex-shrink-0 sticky top-0 z-20">
          <button @click="sidebarOpen = true" type="button"
                  class="lg:hidden inline-flex items-center justify-center p-2 -ml-2 rounded-lg text-gray-500 hover:text-gray-700 hover:bg-gray-100 transition-colors"
                  aria-label="Abrir menú">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
          </button>
          <div class="hidden lg:block"></div>

          <div class="flex items-center relative" @click.away="userOpen = false">
            <button @click="userOpen = !userOpen" type="button"
                    class="flex items-center gap-2 px-2.5 py-1.5 rounded-lg transition-colors hover:bg-gray-100">
              <div class="w-8 h-8 rounded-full flex items-center justify-center text-white text-xs font-bold flex-shrink-0" style="background: linear-gradient(135deg, #0f3d22, #1a6b3a)">
                <%= user_initials %>
              </div>
              <span class="text-sm font-medium text-gray-700 max-w-[140px] truncate hidden sm:block"><%= current_user.email.split("@").first %></span>
              <svg class="w-4 h-4 text-gray-400 transition-transform" :class="userOpen ? 'rotate-180' : ''" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
              </svg>
            </button>

            <!-- Dropdown usuario -->
            <div x-show="userOpen" x-cloak
                 x-transition:enter="transition ease-out duration-100"
                 x-transition:enter-start="opacity-0 scale-95"
                 x-transition:enter-end="opacity-100 scale-100"
                 x-transition:leave="transition ease-in duration-75"
                 x-transition:leave-start="opacity-100 scale-100"
                 x-transition:leave-end="opacity-0 scale-95"
                 class="absolute right-0 top-12 w-56 bg-white rounded-xl shadow-xl border border-gray-100 z-50 overflow-hidden">
              <div class="px-4 py-3 border-b border-gray-100" style="background: linear-gradient(135deg, #0f3d22, #1a6b3a)">
                <p class="text-xs text-white/60">Sesión iniciada como</p>
                <p class="text-sm font-semibold text-white truncate"><%= current_user.email %></p>
              </div>
              <div class="p-2 space-y-0.5">
                <% if admin_user? %>
                  <%= link_to managed_users_path, class: "flex items-center gap-2 px-3 py-2 text-sm text-gray-700 hover:bg-gray-50 rounded-lg transition-colors font-medium" do %>
                    <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
                    </svg>
                    Administrar usuarios
                  <% end %>
                  <div class="border-t border-gray-100 my-1"></div>
                <% end %>
                <%= button_to "Cerrar sesión", destroy_user_session_path,
                      method: :delete,
                      class: "w-full text-left px-3 py-2 text-sm text-red-600 hover:bg-red-50 rounded-lg transition-colors font-medium",
                      form_class: "block" %>
              </div>
            </div>
          </div>
        </header>

        <main class="flex-1 overflow-y-auto">
          <%= yield %>
        </main>
      </div>
    </div>

  <% else %>
    <main>
      <%= yield %>
    </main>
  <% end %>
  </body>
</html>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const alerts = document.querySelectorAll(".flash-alert");
        alerts.forEach(alert => {
            setTimeout(() => {
                alert.classList.add("opacity-0");
                setTimeout(() => alert.remove(), 500);
            }, 3000); // Oculta después de 3 segundos
        });
    });
</script>
