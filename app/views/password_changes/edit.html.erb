<div class="max-w-xl mx-auto px-4 py-8">
  <div class="mb-6">
    <h1 class="text-2xl font-bold text-gray-900">Cambiar contraseña</h1>
    <p class="text-sm text-gray-500 mt-1">Ingresa tu contraseña actual y la nueva contraseña que deseas usar.</p>
  </div>

  <%= form_with model: @user, url: password_change_path, method: :patch, scope: :user, class: "space-y-6" do |f| %>

    <% if @user.errors.any? %>
      <div class="bg-red-50 border border-red-200 rounded-xl p-4">
        <p class="text-sm font-semibold text-red-700 mb-2">Por favor corrige los siguientes errores:</p>
        <ul class="list-disc list-inside space-y-1">
          <% @user.errors.full_messages.each do |msg| %>
            <li class="text-sm text-red-600"><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
      <div class="px-5 py-3 border-b border-gray-100" style="background: linear-gradient(135deg, #0f3d22, #1a6b3a)">
        <h3 class="text-sm font-semibold text-white">Datos de acceso</h3>
      </div>
      <div class="p-5 space-y-4">
        <div>
          <%= f.label :current_password, "Contraseña actual", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.password_field :current_password, required: true, autocomplete: "current-password", class: "w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-transparent" %>
        </div>
        <div>
          <%= f.label :password, "Nueva contraseña", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.password_field :password, required: true, autocomplete: "new-password", minlength: Devise.password_length.min, class: "w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-transparent" %>
          <p class="text-xs text-gray-500 mt-1">Mínimo <%= Devise.password_length.min %> caracteres.</p>
        </div>
        <div>
          <%= f.label :password_confirmation, "Confirmar nueva contraseña", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.password_field :password_confirmation, required: true, autocomplete: "new-password", class: "w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-transparent" %>
        </div>
      </div>
    </div>

    <div class="flex items-center justify-end gap-3">
      <%= link_to "Cancelar", root_path, class: "px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 transition-colors" %>
      <%= f.submit "Cambiar contraseña", class: "px-5 py-2 text-sm font-semibold text-white rounded-lg transition-colors cursor-pointer", style: "background: linear-gradient(135deg, #0f3d22, #1a6b3a)" %>
    </div>
  <% end %>
</div>
